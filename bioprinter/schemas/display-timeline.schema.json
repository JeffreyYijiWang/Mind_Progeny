{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bioprinter display timeline v1",
  "type": "object",
  "required": [
    "schema_version",
    "gcode_sha256",
    "origin",
    "timing",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "gcode_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "asset_id",
          "source_path",
          "source_sha256",
          "svg_path",
          "quadrant",
          "sequence_index",
          "nominal_layer_index",
          "job_id",
          "start_s",
          "end_s",
          "duration_s",
          "deposition_start_s",
          "deposition_end_s",
          "byte_start",
          "byte_end",
          "line_start",
          "line_end",
          "display_action",
          "timing_status"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string"
          },
          "svg_path": {
            "type": "string"
          },
          "quadrant": {
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4"
            ]
          },
          "sequence_index": {
            "type": "integer",
            "minimum": 0
          },
          "nominal_layer_index": {
            "type": "integer",
            "minimum": 0
          },
          "job_id": {
            "type": "string"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "deposition_start_s": {
            "type": "number",
            "minimum": 0
          },
          "deposition_end_s": {
            "type": "number",
            "minimum": 0
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 0
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "line_end": {
            "type": "integer",
            "minimum": 0
          },
          "display_action": {
            "enum": [
              "show",
              "hold",
              "blank"
            ]
          },
          "timing_status": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "total_s",
        "model",
        "status"
      ],
      "properties": {
        "total_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}